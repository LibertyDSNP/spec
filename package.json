{
    "name": "dsnp-spec",
    "version": "1.3.0",
    "description": "Detailed documentation regarding the current state of the protocol",
    "license": "CC-BY-SA-4.0",
    "scripts": {
        "build": "eleventy && pagefind --site _site",
        "serve": "eleventy --serve",
        "watch": "eleventy --watch",
        "linkcheck": "linkinator ./_site --recurse --skip 'en\\.bitcoin\\.it|github\\.com/LibertyDSNP/spec|w3\\.org|nacl\\.cr\\.yp\\.to|cr\\.yp\\.to'",
        "spellcheck": "spellchecker",
        "lint-md": "remark --frail ./pages/**/*.md ./pages/*.md",
        "lint": "npm run lint-md && npm run spellcheck"
    },
    "devDependencies": {
        "@11ty/eleventy": "3.1.6",
        "@pagefind/default-ui": "1.5.2",
        "linkinator": "7.6.1",
        "markdown-it": "14.2.0",
        "markdown-it-anchor": "9.2.0",
        "pagefind": "1.5.2",
        "remark-cli": "12.0.1",
        "remark-lint": "10.0.1",
        "remark-preset-lint-recommended": "7.0.1",
        "spellchecker-cli": "7.0.3"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "remarkConfig": {
        "plugins": [
            "remark-preset-lint-recommended",
            [
                "remark-lint-list-item-indent",
                false
            ]
        ]
    }
}
